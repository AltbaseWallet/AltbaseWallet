{
  "name": "altcoinwallet",
  "productName": "Altbase Wallet",
  "description": "Altbase Wallet",
  "author": "Altbase",
  "homepage": "https://altbase.io",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "electron .",
    "build": "node scripts/build-project.cjs",
    "build:plugin-host": "node scripts/build-plugin-host.cjs",
    "build:plugin-host:windows": "node scripts/build-plugin-host.cjs --windows",
    "build:coin-sdks": "node scripts/build-coin-sdks.cjs",
    "test": "node scripts/test-project.cjs",
    "dist:linux": "node scripts/package-project.cjs linux-x64",
    "dist:win": "node scripts/package-project.cjs win32-x64",
    "dist:mac": "node scripts/package-project.cjs darwin-arm64",
    "test:gui": "electron scripts/qa-plugin-gui.cjs",
    "build:fixtures": "node scripts/build-plugin-fixtures.cjs",
    "test:mining": "node scripts/test-mining.cjs",
    "dist:win:msi": "node scripts/package-project.cjs win32-x64 --msi"
  },
  "dependencies": {
    "@bitgo/utxo-lib": "11.24.4",
    "@ckb-ccc/core": "file:vendor/ckb-ccc-core-1.16.1+altbase.1.tgz",
    "@hookform/resolvers": "^5.2.2",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@qubic-lib/qubic-ts-library": "0.1.6",
    "@scure/base": "1.2.6",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.3.0",
    "clsx": "^2.1.1",
    "elliptic": "file:vendor/elliptic-6.6.1+altbase.1.tgz",
    "ethers": "6.17.0",
    "framer-motion": "^12.38.0",
    "jpeg-js": "0.4.4",
    "kaspa-wasm": "file:vendor/kaspa-wasm-v2.0.1",
    "libnexa-ts": "3.0.3",
    "lucide-react": "^1.14.0",
    "nonsense-wasm": "file:vendor/nonsense-wasm-v0.1.7",
    "pngjs": "7.0.0",
    "qrcode.react": "^4.2.0",
    "quais": "^1.0.0-alpha.54",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^7.15.0",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "tronweb": "6.5.1",
    "ws": "8.21.0",
    "zod": "4.6.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "43.8.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jiti": "^2.7.0",
    "pe-library": "0.4.1",
    "postcss": "^8.5.14",
    "resedit": "1.7.2",
    "ssh2": "^1.17.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "8.1.6",
    "braces": "file:vendor/braces-3.0.3+altbase.1.tgz"
  },
  "build": {
    "appId": "com.altbase.wallet",
    "productName": "Altbase Wallet",
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "logo.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native-core",
        "to": "native-core"
      },
      {
        "from": "coin-runtimes-stage",
        "to": "coin-runtimes"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      },
      {
        "from": "modules/mining",
        "to": "modules/mining",
        "filter": [
          "module.json",
          "package.json",
          "package.manifest.json",
          "catalog/**/*",
          "docs/**/*",
          "dist/src/**/*",
          "dist/frontend/**/*"
        ]
      },
      {
        "from": "coin-plugins",
        "to": "coin-plugins"
      },
      {
        "from": "native-plugin-host/bin",
        "to": "native-plugin-host/bin"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Finance",
      "icon": "logo.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Altbase-Wallet-Linux-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.finance",
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "LSArchitecturePriority": [
          "arm64",
          "x86_64"
        ]
      },
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Altbase-Wallet-macOS.${ext}",
      "x64ArchFiles": "Contents/Resources/{native-core/**,coin-runtimes/**,app.asar.unpacked/node_modules/secp256k1/prebuilds/**}"
    },
    "npmRebuild": false,
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Altbase-Wallet-Windows-x64-v${version}.msi"
    }
  },
  "overrides": {
    "elliptic": "$elliptic",
    "axios": "1.20.0",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^2.0.1": "2.1.7",
    "fast-uri": "3.1.9",
    "http-cache-semantics": "4.3.0",
    "braces": "$braces",
    "brace-expansion@^5.0.0": "5.0.12",
    "zod": "$zod",
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
